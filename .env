# .env
# ----
# This file stores environment variables for the Flask application.
# It is used by tools like `direnv` to automatically set these variables
# when you are in the project's directory.
#
# Usage:
# 1. Install direnv: https://direnv.net/
# 2. Create this .env file in your project's root directory.
# 3. Create a .envrc file in the same directory with the following content:
#    source .env
# 4. Run `direnv allow` in the project directory to allow direnv to load the variables.

# Flask environment
FLASK_ENV=development
#  You can change this to "production" or "testing" as needed.
#  FLASK_ENV=production

# Flask secret key (VERY IMPORTANT!  Change this to a strong, random value)
SECRET_KEY=your_secret_key
#  Generate a secure key with:
#  python -c 'import secrets; print(secrets.token_hex(24))'

# Logging level
LOG_LEVEL=INFO
#  Possible values: DEBUG, INFO, WARNING, ERROR, CRITICAL

#  Production-specific settings (optional)
# PORT=5000
